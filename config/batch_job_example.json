{
  "job_name": "clas12_analysis",
  "executable": "./builddir/improved",
  "system": "slurm",

  "data_dir": "/work/clas12/data/RG-A/",
  "output_dir": "./batch_output",
  "log_dir": "./batch_logs",

  "files_per_job": 10,
  "n_cores": 4,
  "memory_gb": 8,
  "time_limit": "12:00:00",
  "partition": "production",

  "email": "user@university.edu",

  "comments": [
    "Generic batch configuration for any CLAS12 analysis",
    "Change 'executable' to your analysis: ./builddir/pi0, ./builddir/lambda, etc.",
    "",
    "Usage:",
    "  ./batch --config=config/batch_job_example.json",
    "  ./batch --config=config/batch_job_example.json --submit",
    "",
    "Or use command-line directly:",
    "  ./batch ./builddir/pi0 --target=LD2 --polarity=Outbending",
    "  ./batch ./builddir/electron_analysis --data-dir=/path/to/data"
  ]
}
