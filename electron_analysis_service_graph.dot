digraph Workflow {
  // Graph settings
  rankdir=TB;
  node [shape=box, style=rounded];
  edge [fontsize=10];
  graph [fontname="Helvetica", fontsize=12];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica"];

  // Nodes
  "ConditionsService" [label="ConditionsService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "ElectronAnalysis" [label="ElectronAnalysis", fillcolor="lightblue", style="filled,rounded", shape=box];
  "ElectronCutsService" [label="ElectronCutsService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "EventMonitor" [label="EventMonitor", fillcolor="lightblue", style="filled,rounded", shape=box];
  "HipoFileService" [label="HipoFileService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "HistogramService" [label="HistogramService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "LoggingService" [label="LoggingService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "MetadataService" [label="MetadataService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "NTupleService" [label="NTupleService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "OutputFileService" [label="OutputFileService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "ParticleSelectorService" [label="ParticleSelectorService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "ProfilingService" [label="ProfilingService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];
  "SamplingFractionService" [label="SamplingFractionService", fillcolor="lightgreen", style="filled,rounded", shape=ellipse];

  // Edges
  "EventMonitor" -> "ElectronAnalysis" [style=solid, color="blue"];

  // Clustering
  subgraph cluster_algorithms {
    label="Algorithms";
    style=dashed;
    color=gray;
    "ElectronAnalysis";
    "EventMonitor";
  }

  subgraph cluster_services {
    label="Services";
    style=dashed;
    color=gray;
    "ConditionsService";
    "ElectronCutsService";
    "HipoFileService";
    "HistogramService";
    "LoggingService";
    "MetadataService";
    "NTupleService";
    "OutputFileService";
    "ParticleSelectorService";
    "ProfilingService";
    "SamplingFractionService";
  }
}
