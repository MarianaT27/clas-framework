#include <cstdint>
#include <study1/Reader.hpp>
#include <vector>
#include "Core/Banks.hpp"
#include "Core/Constants.hpp"
#include "Core/Cuts.hpp"
#include "Core/PIDs.hpp"
#include "Core/Particle.hpp"
#include "Core/ReadBank.hpp"
#include "hipoeventiterator.h"

namespace study1 {

Reader::Reader(Histograms& histograms)
    : m_histograms(histograms) {}

Reader::~Reader() = default;

auto Reader::operator()(const std::string& file) -> void {
    for (hipo::hipoeventfile events(file); auto& event : events) {
        hipo::bank_map REC_Event = event.get_bank_map("REC::Event");
        if (REC_Event.get_rows() == 0) continue;
        double start_time = REC_Event.get_as<double>("startTime", 0);


        hipo::bank_map MC_Particle = event.get_bank_map("MC::Particle");
        hipo::bank_map MC_GenMatch = event.get_bank_map("MC::GenMatch");
        hipo::bank_map MC_RecMatch = event.get_bank_map("MC::RecMatch");
        hipo::bank_map REC_Particle = event.get_bank_map("REC::Particle");
        hipo::bank_map REC_Scintillator = event.get_bank_map("REC::Scintillator");
        hipo::bank_map REC_Calorimeter = event.get_bank_map("REC::Calorimeter");

        // MC truth information -----------------------------------------------------------
        if (MC_Particle.get_rows() == 0) continue;
        for (int i = 0; i < MC_Particle.get_rows(); ++i) {
            int pid = MC_Particle.get_as<int>("pid", i);
            double px = MC_Particle.get_as<double>("px", i);
            double py = MC_Particle.get_as<double>("py", i);
            double pz = MC_Particle.get_as<double>("pz", i);
            double p = std::sqrt(px * px + py * py + pz * pz);

            int pindex = Core::get_rec_particle_index(*MC_GenMatch.get_bank(), i);
            if (pindex >= 0) {
                Core::ScintillatorBank scintillator = Core::read_Scintillator_bank(*REC_Scintillator.get_bank(), pindex);
                Core::CalorimeterBank calorimeter = Core::read_Calorimeter_bank(*REC_Calorimeter.get_bank(), pindex);

                int rec_pid = REC_Particle.get("pid", pindex);
                double rec_px = REC_Particle.get("px", pindex);
                double rec_py = REC_Particle.get("py", pindex);
                double rec_pz = REC_Particle.get("pz", pindex);
                double rec_p = std::sqrt(rec_px * rec_px + rec_py * rec_py + rec_pz * rec_pz);

                double measured_time = scintillator.time - start_time;
                double l_ftof = scintillator.path;
                double m = Core::Constants::PionMass;
                double beta_expected = rec_p / std::sqrt(rec_p * rec_p + m * m);
                double t_expected = l_ftof / (beta_expected * Core::Constants::SPEED_OF_LIGHT);
                double delta_t = measured_time - t_expected;

                if (pid == static_cast<int>(Core::PIDs::PionMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_pim->Get()->Fill(rec_p, delta_t);
                if (pid == static_cast<int>(Core::PIDs::KaonMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_km->Get()->Fill(rec_p, delta_t);
                if (pid == static_cast<int>(Core::PIDs::Electron)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_electron->Get()->Fill(rec_p, delta_t);
                if (pid == static_cast<int>(Core::PIDs::Photon)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_photon->Get()->Fill(rec_p, delta_t);

                double SF_PCal = calorimeter.pcal.energy / rec_p;
                double SF_inner = calorimeter.inner.energy / rec_p;

                if (cut_delta_t(rec_p, delta_t) && (SF_inner < 0.2 - SF_PCal || SF_PCal < 0.02)) {
                    if (pid == static_cast<int>(Core::PIDs::PionMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_pim_cut->Get()->Fill(rec_p, delta_t);
                    if (pid == static_cast<int>(Core::PIDs::KaonMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_km_cut->Get()->Fill(rec_p, delta_t);
                    if (pid == static_cast<int>(Core::PIDs::Electron)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_electron_cut->Get()->Fill(rec_p, delta_t);
                    if (pid == static_cast<int>(Core::PIDs::Photon)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_photon_cut->Get()->Fill(rec_p, delta_t);
                }
                
            }
        }

        // --------------------------------------------------------------------------------

        // Get trigger electron
        std::optional<Core::Particle> trigger_e = evt.trigger_electron({2000, 4000});
        if (!trigger_e.has_value()) continue;

        // Apply electron ID
        Core::CalorimeterBank calorimeter = evt.calorimeter(trigger_e.value());
        Core::DCTrajBank traj = evt.trajectory(trigger_e.value());
        Core::ElectronCuts::CutResults cuts_results = Core::ElectronCuts::apply_all_cuts(trigger_e.value(), calorimeter, traj, m_target, m_polarity, m_sf_cut);
        if (!cuts_results.passes_all_required()) continue;

        // π- selection
        std::vector<Core::Particle> pions = evt.pions_minus();
        for (const Core::Particle& pion : pions) {
            Core::ScintillatorBank scintillator = evt.scintillator(pion);
            Core::CalorimeterBank calorimeter = evt.calorimeter(pion);
            double measured_time = scintillator.time - start_time;
            double l_ftof = scintillator.path;
            double p = pion.p();
            double m = Core::Constants::PionMass;
            double beta_expected = p / std::sqrt(p * p + m * m);
            double t_expected = l_ftof / (beta_expected * Core::Constants::SPEED_OF_LIGHT);
            double delta_t = measured_time - t_expected;

            m_histograms.pion_minus.hist2D_delta_t_vs_p_reconstructed_pim->Get()->Fill(p, delta_t);
            if (cut_delta_t(p, delta_t)) m_histograms.pion_minus.hist2D_delta_t_vs_p_reconstructed_pim_cut->Get()->Fill(p, delta_t);

            int mc_index = Core::get_mc_particle_index(*MC_RecMatch.get_bank(), pion.index());
            if (mc_index >= 0) {
                int mc_pid = MC_Particle.get("pid", mc_index);

                if (mc_pid == static_cast<int>(Core::PIDs::PionMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_pim_in_recon->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::KaonMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_km_in_recon->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Electron)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_electron_in_recon->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Photon)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_photon_in_recon->Get()->Fill(p, delta_t);

                double SF_PCal = calorimeter.pcal.energy / p;
                double SF_inner = calorimeter.inner.energy / p;

                if (cut_delta_t(p, delta_t) && (SF_inner < 0.2 - SF_PCal || SF_PCal < 0.02)) {
                    if (mc_pid == static_cast<int>(Core::PIDs::PionMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_pim_in_recon_cut->Get()->Fill(p, delta_t);
                    if (mc_pid == static_cast<int>(Core::PIDs::KaonMinus)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_km_in_recon_cut->Get()->Fill(p, delta_t);
                    if (mc_pid == static_cast<int>(Core::PIDs::Electron)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_electron_in_recon_cut->Get()->Fill(p, delta_t);
                    if (mc_pid == static_cast<int>(Core::PIDs::Photon)) m_histograms.pion_minus.hist2D_delta_t_vs_p_matched_photon_in_recon_cut->Get()->Fill(p, delta_t);
                }
            }
        }

        // π+ selection
        std::vector<Core::Particle> pions_plus = evt.pions_plus();
        for (const Core::Particle& pion : pions_plus) {
            Core::ScintillatorBank scintillator = evt.scintillator(pion);
            Core::CalorimeterBank calorimeter = evt.calorimeter(pion);
            double measured_time = scintillator.time - start_time;
            double l_ftof = scintillator.path;
            double p = pion.p();
            double m = Core::Constants::PionMass;
            double beta_expected = p / std::sqrt(p * p + m * m);
            double t_expected = l_ftof / (beta_expected * Core::Constants::SPEED_OF_LIGHT);
            double delta_t = measured_time - t_expected;
            
            m_histograms.pion_plus.hist2D_delta_t_vs_p_reconstructed_pip->Get()->Fill(p, delta_t);

            int mc_index = Core::get_mc_particle_index(*MC_RecMatch.get_bank(), pion.index());
            if (mc_index >= 0) {
                int mc_pid = MC_Particle.get("pid", mc_index);

                if (mc_pid == static_cast<int>(Core::PIDs::PionPlus)) m_histograms.pion_plus.hist2D_delta_t_vs_p_matched_pip_in_recon_pip->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::KaonPlus)) m_histograms.pion_plus.hist2D_delta_t_vs_p_matched_kp_in_recon_pip->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Proton)) m_histograms.pion_plus.hist2D_delta_t_vs_p_matched_proton_in_recon_pip->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Positron)) m_histograms.pion_plus.hist2D_delta_t_vs_p_matched_positron_in_recon_pip->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Photon)) m_histograms.pion_plus.hist2D_delta_t_vs_p_matched_photon_in_recon_pip->Get()->Fill(p, delta_t);
            }
        
        }

        // negative tracks that are not electrons 
        std::vector<Core::Particle> negative_tracks;
        for (int i = 0; i < REC_Particle.get_rows(); ++i) {
            const int pid = REC_Particle.get("pid", i);
            const int status = REC_Particle.get("status", i);
            const int charge = REC_Particle.get("charge", i);
            const double px = REC_Particle.get("px", i);
            const double py = REC_Particle.get("py", i);
            const double pz = REC_Particle.get("pz", i);
            const double vx = REC_Particle.get("vx", i);
            const double vy = REC_Particle.get("vy", i);
            const double vz = REC_Particle.get("vz", i);
            const double vt = REC_Particle.get("vt", i);
            const double beta = REC_Particle.get("beta", i);
            const double chi2pid = REC_Particle.get("chi2pid", i);

            const double mass = Core::get_mass(pid);
            const double E = Core::compute_energy(px, py, pz, pid);

            Core::Particle particle(pid, status, i, charge, mass, px, py, pz, E, vx, vy, vz, vt, beta, chi2pid);
            if (charge < 0 && pid != 11) negative_tracks.push_back(particle);
        }



        for (const Core::Particle& neg_track : negative_tracks) {
            Core::ScintillatorBank scintillator = evt.scintillator(neg_track);
            Core::CalorimeterBank calorimeter = evt.calorimeter(neg_track);
            double measured_time = scintillator.time - start_time;
            double l_ftof = scintillator.path;
            double p = neg_track.p();
            double m = Core::Constants::PionMass;
            double beta_expected = p / std::sqrt(p * p + m * m);
            double t_expected = l_ftof / (beta_expected * Core::Constants::SPEED_OF_LIGHT);
            double delta_t = measured_time - t_expected;
            
            m_histograms.negative_tracks.hist2D_delta_t_vs_p_reconstructed_neg_tracks->Get()->Fill(p, delta_t);

            int mc_index = Core::get_mc_particle_index(*MC_RecMatch.get_bank(), neg_track.index());
            if (mc_index >= 0) {
                int mc_pid = MC_Particle.get("pid", mc_index);

                if (mc_pid == static_cast<int>(Core::PIDs::PionMinus)) m_histograms.negative_tracks.hist2D_delta_t_vs_p_matched_pim_in_recon_neg_tracks->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::KaonMinus)) m_histograms.negative_tracks.hist2D_delta_t_vs_p_matched_km_in_recon_neg_tracks->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Electron)) m_histograms.negative_tracks.hist2D_delta_t_vs_p_matched_electron_in_recon_neg_tracks->Get()->Fill(p, delta_t);
                if (mc_pid == static_cast<int>(Core::PIDs::Photon)) m_histograms.negative_tracks.hist2D_delta_t_vs_p_matched_photon_in_recon_neg_tracks->Get()->Fill(p, delta_t);
            }
        }
    }
}

double Reader::third_order_poly(double x, double a, double b, double c, double d) const {
    return a + b * x + c * x * x + d * x * x * x;
}

bool Reader::cut_delta_t(double p, double delta_t) const {
    const double popt_mean[4] = {-0.02872196, 0.00598219, 0.00158193, -0.00028493};
    const double popt_sigma[4] = {0.25132972, -0.09788015, 0.01734634, -0.00103597};

    double cut_low = third_order_poly(p, popt_mean[0], popt_mean[1], popt_mean[2], popt_mean[3]) -
                     3 * third_order_poly(p, popt_sigma[0], popt_sigma[1], popt_sigma[2], popt_sigma[3]);
    double cut_high = third_order_poly(p, popt_mean[0], popt_mean[1], popt_mean[2], popt_mean[3]) +
                      3 * third_order_poly(p, popt_sigma[0], popt_sigma[1], popt_sigma[2], popt_sigma[3]);

    return cut_low < delta_t && delta_t < cut_high;
}

}  // namespace study1