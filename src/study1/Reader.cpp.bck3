namespace study1 {

Reader::Reader(Histograms& histograms)
    : m_histograms(histograms) {}

Reader::~Reader() = default;

auto Reader::operator()(hipo::iter_event& event) -> void {
    hipo::bank_map& REC_Particle = event.get_bank_map("REC::Particle");
    hipo::bank_map& REC_Calorimeter = event.get_bank_map("REC::Calorimeter");
    hipo::bank_map& REC_Cherenkov = event.get_bank_map("REC::Cherenkov");
    hipo::bank_map& REC_Traj = event.get_bank_map("REC::Traj");
    hipo::bank_map& REC_Track = event.get_bank_map("REC::Track");

    Core::ParticleMap particles = Core::ParticleSelector::extract_particles(REC_Particle, {Core::PIDs::ELECTRON, Core::PIDs::PIMINUS, Core::PIDs::PIPLUS, Core::PIDs::KMINUS, Core::PIDs::KPLUS});

    // Select trigger electron
    const auto& electrons = particles[Core::PIDs::ELECTRON];
    std::optional<Core::Particle> trigger_e = Core::find_trigger_electron(electrons, {2000, 4000});
    if (!trigger_e.has_value()) return;

    std::vector<Core::Particle> pims = particles[Core::PIDs::PIMINUS];
    std::vector<Core::Particle> pips = particles[Core::PIDs::PIPLUS];

    for (const auto& pim : pims) {
        const Core::CalorimeterBank calorimeter = Core::read_Calorimeter_bank(REC_Calorimeter.get_bank(), pim.index());
        const Core::CherenkovBank cherenkov = Core::read_Cherenkov_bank(REC_Cherenkov.get_bank(), pim.index());

        const Core::DCTrajBank traj = Core::read_Traj_bank(REC_Traj.get_bank(), pim.index());
        const Core::TrackBank track_R1 = Core::read_Track_bank(REC_Track.get_bank(), traj.region1.index);
        const Core::TrackBank track_R2 = Core::read_Track_bank(REC_Track.get_bank(), traj.region2.index);
        const Core::TrackBank track_R3 = Core::read_Track_bank(REC_Track.get_bank(), traj.region3.index);

        const int sector = track_R1.sector;
        const double edge1 = traj.region1.edge;
        const double edge2 = traj.region2.edge;
        const double edge3 = traj.region3.edge;
        const double sampling_fraction = (calorimeter.pcal.energy + calorimeter.inner.energy + calorimeter.outer.energy) / pim.p();

        if (sector < 1 || sector > 6) continue;
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_edge_vs_chi2ndf_region1->Get()->Fill(edge1, track_R1.chi2 / track_R1.ndf);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_edge_vs_chi2ndf_region2->Get()->Fill(edge2, track_R2.chi2 / track_R2.ndf);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_edge_vs_chi2ndf_region3->Get()->Fill(edge3, track_R3.chi2 / track_R3.ndf);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_u_vs_SF->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_v_vs_SF->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_w_vs_SF->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_u_vs_SF_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_v_vs_SF_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_w_vs_SF_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_u_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_v_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_w_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_u_vs_SF_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[sector - 1].hist2D_u_vs_SF_end_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);

        // All sectors 
        m_histograms.pim_track.sector_histograms[6].hist2D_edge_vs_chi2ndf_region1->Get()->Fill(edge1, track_R1.chi2 / track_R1.ndf);
        m_histograms.pim_track.sector_histograms[6].hist2D_edge_vs_chi2ndf_region2->Get()->Fill(edge2, track_R2.chi2 / track_R2.ndf);
        m_histograms.pim_track.sector_histograms[6].hist2D_edge_vs_chi2ndf_region3->Get()->Fill(edge3, track_R3.chi2 / track_R3.ndf);
        m_histograms.pim_track.sector_histograms[6].hist2D_u_vs_SF->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_v_vs_SF->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_w_vs_SF->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_u_vs_SF_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_v_vs_SF_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_w_vs_SF_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_u_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_v_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_w_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_u_vs_SF_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pim_track.sector_histograms[6].hist2D_u_vs_SF_end_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
    }

    for (const auto& pip : pips) {
        const Core::CalorimeterBank calorimeter = Core::read_Calorimeter_bank(REC_Calorimeter.get_bank(), pip.index());
        const Core::CherenkovBank cherenkov = Core::read_Cherenkov_bank(REC_Cherenkov.get_bank(), pip.index());

        const Core::DCTrajBank traj = Core::read_Traj_bank(REC_Traj.get_bank(), pip.index());
        const Core::TrackBank track_R1 = Core::read_Track_bank(REC_Track.get_bank(), traj.region1.index);
        const Core::TrackBank track_R2 = Core::read_Track_bank(REC_Track.get_bank(), traj.region2.index);
        const Core::TrackBank track_R3 = Core::read_Track_bank(REC_Track.get_bank(), traj.region3.index);

        const int sector = track_R1.sector;
        const double edge1 = traj.region1.edge;
        const double edge2 = traj.region2.edge;
        const double edge3 = traj.region3.edge;
        const double sampling_fraction = (calorimeter.pcal.energy + calorimeter.inner.energy + calorimeter.outer.energy) / pip.p();

        if (sector < 1 || sector > 6) continue;
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_edge_vs_chi2ndf_region1->Get()->Fill(edge1, track_R1.chi2 / track_R1.ndf);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_edge_vs_chi2ndf_region2->Get()->Fill(edge2, track_R2.chi2 / track_R2.ndf);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_edge_vs_chi2ndf_region3->Get()->Fill(edge3, track_R3.chi2 / track_R3.ndf);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_u_vs_SF->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_v_vs_SF->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_w_vs_SF->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_u_vs_SF_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_v_vs_SF_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_w_vs_SF_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_u_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_v_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_w_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_u_vs_SF_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[sector - 1].hist2D_u_vs_SF_end_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);

                // All sectors 
        m_histograms.pip_track.sector_histograms[6].hist2D_edge_vs_chi2ndf_region1->Get()->Fill(edge1, track_R1.chi2 / track_R1.ndf);
        m_histograms.pip_track.sector_histograms[6].hist2D_edge_vs_chi2ndf_region2->Get()->Fill(edge2, track_R2.chi2 / track_R2.ndf);
        m_histograms.pip_track.sector_histograms[6].hist2D_edge_vs_chi2ndf_region3->Get()->Fill(edge3, track_R3.chi2 / track_R3.ndf);
        m_histograms.pip_track.sector_histograms[6].hist2D_u_vs_SF->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_v_vs_SF->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_w_vs_SF->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_u_vs_SF_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_v_vs_SF_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_w_vs_SF_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_u_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_v_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lv, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_w_vs_SF_end_zoom->Get()->Fill(calorimeter.inner.lw, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_u_vs_SF_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
        m_histograms.pip_track.sector_histograms[6].hist2D_u_vs_SF_end_zoom_cut->Get()->Fill(calorimeter.inner.lu, sampling_fraction);
    }


}

double Reader::third_order_poly(double x, double a, double b, double c, double d) const {
    return a + b * x + c * x * x + d * x * x * x;
}

bool Reader::cut_delta_t(double p, double delta_t) const {
    const double popt_mean[4] = {-0.02872196, 0.00598219, 0.00158193, -0.00028493};
    const double popt_sigma[4] = {0.25132972, -0.09788015, 0.01734634, -0.00103597};

    double cut_low = third_order_poly(p, popt_mean[0], popt_mean[1], popt_mean[2], popt_mean[3]) -
                     3 * third_order_poly(p, popt_sigma[0], popt_sigma[1], popt_sigma[2], popt_sigma[3]);
    double cut_high = third_order_poly(p, popt_mean[0], popt_mean[1], popt_mean[2], popt_mean[3]) +
                      3 * third_order_poly(p, popt_sigma[0], popt_sigma[1], popt_sigma[2], popt_sigma[3]);

    return cut_low < delta_t && delta_t < cut_high;
}

/**
 * @brief Computes the local polar angle (theta) in the Drift Chamber (DC) coordinate system for a given point and sector.
 *
 * This function transforms the local coordinates (x, y, z) into the tilted local sector coordinate system
 * and calculates the polar angle theta (in degrees) with respect to the z-axis.
 *
 * @param x      The x-coordinate in the local coordinate system.
 * @param y      The y-coordinate in the local coordinate system.
 * @param z      The z-coordinate in the local coordinate system.
 * @param sector The sector number (1-based index) in which the calculation is performed.
 * @return The local polar angle theta in degrees.
 */
auto Reader::compute_local_theta_DC(const double x, const double y, const double z, const int sector) const -> double {
    double angle = (sector - 1) * SECTOR_ANGLE;
    double s = std::sin(angle);
    double c = std::cos(angle);
    return std::atan2(std::hypot(c * x - s * y, s * x + c * y), z) * 180.0 / TMath::Pi();
}


